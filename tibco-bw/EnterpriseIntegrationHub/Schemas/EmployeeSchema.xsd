<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.tibco.com/bw/samples/employee"
           xmlns="http://www.tibco.com/bw/samples/employee">
  <xs:element name="OnboardRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="name" type="xs:string"/>
        <xs:element name="email" type="xs:string"/>
        <xs:element name="department" type="xs:string"/>
        <xs:element name="salary" type="xs:decimal"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="OnboardResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="employeeId" type="xs:string"/>
        <xs:element name="employeeCreated" type="xs:boolean"/>
        <xs:element name="payrollCreated" type="xs:boolean"/>
        <xs:element name="attendanceCreated" type="xs:boolean"/>
        <xs:element name="notificationSent" type="xs:boolean"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
